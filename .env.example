# ─────────────────────────────────────────────────────────────────────────────
# Forge Careers – Environment Variables
# Copy this file to .env and fill in your real values before running
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# The sender address shown in all candidate emails
MAIL_USER=""

# Gmail App Password (NOT your Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Steps:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to Security → App Passwords → Select app: Mail, device: Other
#   3. Copy the 16-character password (no spaces) and paste below
MAIL_PASS=xxxx xxxx xxxx xxxx

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
